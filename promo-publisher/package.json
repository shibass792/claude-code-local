{
  "name": "shibass-social-studio",
  "version": "2.0.0",
  "description": "ShiBass Standalone Social Media Desktop Studio — radar, approval hub, and multi-platform publishing",
  "main": "main.js",
  "scripts": {
    "start": "electron . --disable-gpu --disable-gpu-sandbox --no-sandbox",
    "start:win": "electron . --disable-gpu-shader-disk-cache",
    "radar:scan": "node modules/radar.js --scan",
    "library:scan": "node scripts/scan-library.js",
    "render:reel": "node scripts/render-reel.js",
    "doctor": "node scripts/doctor.js",
    "import:social": "node scripts/import-social-inbox.js",
    "api": "node studio-api.js",
    "test": "node --test tests/*.test.js",
    "lint": "node scripts/lint.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "electron": "^31.7.6"
  },
  "engines": {
    "node": ">=18"
  }
}
