{
  "name": "shibass-social-studio",
  "version": "2.1.0",
  "description": "ShiBass Standalone Social Media Desktop Studio — live FFmpeg/Ollama/Meta APIs + Universal Player",
  "main": "main.js",
  "scripts": {
    "start": "electron . --disable-gpu --disable-gpu-sandbox --no-sandbox",
    "start:win": "electron . --disable-gpu-shader-disk-cache",
    "api": "node api-server.js",
    "transcriber": "node transcriber-server.js",
    "cli": "node cli.js",
    "mcp": "node mcp-server.js",
    "psy": "node cli.js psy 10",
    "pack": "node cli.js pack 50",
    "sprint": "node cli.js sprint",
    "ops": "node cli.js ops",
    "radar:scan": "node modules/radar.js --scan",
    "import:social": "node scripts/import-social-inbox.js",
    "test": "node --test tests/*.test.js",
    "lint": "node --check main.js preload.js api-server.js transcriber-server.js line-compat-4000.js cli.js mcp-server.js modules/*.js modules/publishers/*.js ui/app.js web/studio.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "electron": "^31.7.6"
  },
  "engines": {
    "node": ">=18"
  }
}
