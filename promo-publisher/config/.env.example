# Meta Graph API (Instagram + Facebook)
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_IG_USER_ID=
META_ACCESS_TOKEN=

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
# draft | direct
TIKTOK_PUBLISH_MODE=draft

# Optional: Cloudflare Tunnel (for serving local video to Meta)
CLOUDFLARE_TUNNEL_TOKEN=

# Local Ollama for hooks / captions
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=myllama

# Real engines API (creation log, Graph, FFmpeg, player)
ENGINES_API_HOST=127.0.0.1
ENGINES_API_PORT=4051
# Comma-separated folders to index (WAV/MP3/MIDI)
MUSIC_ROOTS=
# Optional font for 9:16 hook overlay
REEL_FONT=
