# =============================================================================
# ShiBass Social Studio — real integrations
#
# Copy to config/.env and fill in what you need. Run `npm run doctor` to see
# exactly which integrations are reachable and which are still unconfigured.
# =============================================================================

# -----------------------------------------------------------------------------
# Local AI — hooks, captions, hashtags
# -----------------------------------------------------------------------------
# Default target is the always-on Ollama service on 11434.
OLLAMA_HOST=http://127.0.0.1:11434
# Leave blank to auto-pick the first model the engine reports from /api/tags.
OLLAMA_MODEL=

# To use an OpenAI-compatible endpoint instead (proxy/server.py, smart-router),
# set AI_BASE_URL — it takes priority over OLLAMA_HOST.
# AI_BASE_URL=http://127.0.0.1:8080/v1
# AI_API_KEY=
# AI_MODEL=
# AI_TIMEOUT_MS=120000

# -----------------------------------------------------------------------------
# Video renderer (FFmpeg)
# -----------------------------------------------------------------------------
# Only needed when ffmpeg/ffprobe are not on PATH.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
# Auto-detected by test-encoding; set to force one (h264_nvenc, libx264, ...).
# RENDER_ENCODER=
RENDER_FPS=30
RENDER_DURATION=15
# RENDER_BG=#0f1117
# Font used for burned-in captions — must cover Hebrew.
# RENDER_FONT=DejaVu Sans

# -----------------------------------------------------------------------------
# Music library index
# -----------------------------------------------------------------------------
# Folders to scan, separated by ; or , — the player index is built from these.
# MUSIC_ROOTS=H:\shibass-ai\10_OUTPUTS;C:\Users\shibass\Documents\ShiBass Synth Samples
# MUSIC_SCAN_DEPTH=6
# MUSIC_SCAN_MAX_FILES=20000
# MUSIC_PROBE_CONCURRENCY=4

# -----------------------------------------------------------------------------
# Artist radar (yt-dlp)
# -----------------------------------------------------------------------------
# Install with: pip install -U yt-dlp
# YTDLP_PATH=yt-dlp
# RADAR_POSTS_PER_ARTIST=12
# RADAR_OUTLIER_THRESHOLD=2.5
# RADAR_TIMEOUT_MS=90000
# Instagram and TikTok listings need a logged-in session. Pick one:
# YTDLP_COOKIES_FILE=C:\shibass\cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome
# Set to 1 to fall back to the labelled sample feed when no live source answers.
# RADAR_ALLOW_SAMPLE=0

# -----------------------------------------------------------------------------
# Meta Graph API (Instagram Reels + Facebook Page video)
# -----------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_IG_USER_ID=
META_ACCESS_TOKEN=
# META_GRAPH_VERSION=v21.0
# Reels transcoding is asynchronous; these bound the container status polling.
# META_POLL_INTERVAL_MS=4000
# META_POLL_TIMEOUT_MS=300000

# -----------------------------------------------------------------------------
# TikTok Content Posting API
# -----------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
# draft  -> uploads to your TikTok drafts (inbox endpoint, no review needed)
# direct -> posts publicly (requires an audited app for PUBLIC_TO_EVERYONE)
TIKTOK_PUBLISH_MODE=draft
# TIKTOK_POLL_INTERVAL_MS=4000
# TIKTOK_POLL_TIMEOUT_MS=300000

# -----------------------------------------------------------------------------
# Public URL for the video file
# -----------------------------------------------------------------------------
# Meta and TikTok download the file over the public internet, so a local
# 127.0.0.1 URL will not work. Install cloudflared or set a tunnel token.
CLOUDFLARE_TUNNEL_TOKEN=

# -----------------------------------------------------------------------------
# Safety
# -----------------------------------------------------------------------------
# Set to 1 to exercise the whole approval flow without calling any platform API.
# Publishing stays disabled while this is 1.
PUBLISH_DRY_RUN=0

# Where renders, the approval queue, the radar feed and the music index are
# written. Defaults to promo-publisher/output. The test suite points this at a
# temp dir so `npm test` never overwrites your real queue.
# SHIBASS_OUTPUT_DIR=
