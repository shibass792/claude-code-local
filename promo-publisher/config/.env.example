# Meta Graph API (Instagram + Facebook)
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_IG_USER_ID=
META_ACCESS_TOKEN=

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
# draft | direct
TIKTOK_PUBLISH_MODE=draft

# Optional: Cloudflare Tunnel (for serving local video to Meta)
CLOUDFLARE_TUNNEL_TOKEN=

# Local Ollama for hooks / captions (ReelHook)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Studio HTTP API
SHIBASS_API_HOST=127.0.0.1
SHIBASS_API_PORT=4051

# Media roots for Universal Player scan (optional; auto-detects fixtures + common folders)
# Windows example: H:\ShiBass_Media;C:\Users\shibass\Documents\ShiBass Synth Samples
# SHIBASS_MEDIA_ROOTS=
