# Meta Graph API (Instagram + Facebook)
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_IG_USER_ID=
META_ACCESS_TOKEN=

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
# draft | direct
TIKTOK_PUBLISH_MODE=draft

# Optional: Cloudflare Tunnel (for serving local video to Meta)
CLOUDFLARE_TUNNEL_TOKEN=

# Local Ollama for hooks / captions
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=myllama

# Optional OpenAI-compatible fallback (local MLX / LiteLLM / etc.)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Studio HTTP API
STUDIO_API_PORT=4052
SHIBASS_MUSIC_ROOTS=
# Semicolon-separated folders of track artwork / reel backgrounds (jpg/png/webp)
SHIBASS_BG_ROOTS=
RADAR_ALLOW_SAMPLE=0

# Optional unofficial InstaPy (own account only). Prefer META_* Graph API.
INSTAPY_ENABLED=0
