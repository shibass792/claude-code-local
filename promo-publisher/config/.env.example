# Meta Graph API (Instagram + Facebook)
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_IG_USER_ID=
META_ACCESS_TOKEN=

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
# draft | direct
TIKTOK_PUBLISH_MODE=draft

# Optional: Cloudflare Tunnel (for serving local video to Meta)
CLOUDFLARE_TUNNEL_TOKEN=

# Local Ollama for hooks / captions
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Real local API server (default matches live topology port 4050)
SHIBASS_API_PORT=4050

# Music roots for Universal Player (comma or semicolon separated)
SHIBASS_MUSIC_ROOTS=

# Set to 1 only for local dry-run publish tests
SHIBASS_ALLOW_MOCK_PUBLISH=0
